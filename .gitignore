.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IntelliJ IDEA
.idea/

# Claude Code
.claude/
CLAUDE.md

# 작업 메모 (개인용)
context/

# 책 디벨롭 HANDOFF (대화 캡처 — 반영은 별도 세션)
handoff/

# Kafka Connect 데이터 (테스트 산출물)
connect-data/
